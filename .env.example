# =========================================================
# Smart Object Detection – environment variable template
# Copy this file to .env and fill in values locally.
# NEVER commit .env to Git.
# =========================================================

# --- Application -----------------------------------------
APP_ENV=development           # development | production
APP_DEBUG=true
SECRET_KEY=change-me-before-production

# --- Database --------------------------------------------
DATABASE_URL=sqlite:///./data/violations.db
CAPTURES_DIR=./data/captures

# --- Server ----------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Detection / OCR (swap in your own keys) -----------
# OCR_PROVIDER=local            # local | google_vision | azure
# OCR_API_KEY=

# --- Automated Email Notification (SMTP) -----------------
# Leave SMTP_HOST empty for Safe Dry-Run (logs emails without sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=traffic-alerts@campus.edu
AUTHORITY_EMAIL=campus-security@campus.edu

# --- Camera / Stream (optional) -------------------------
# CAMERA_INDEX=0
# RTSP_URL=rtsp://user:pass@192.168.1.100:554/stream
